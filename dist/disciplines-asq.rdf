  </ns0:Concept>
  <ns0:Concept rdf:about="http://scenepro.ca/taxonomies/Disciplines-asq#AfroCaribeenne">
    <ns0:broader>
      <ns0:Concept rdf:about="http://scenepro.ca/taxonomies/Disciplines-asq#CaribeenneEtLatinoAmericaine">
        <ns0:broader>
          <ns0:Concept rdf:about="http://scenepro.ca/taxonomies/Disciplines-asq#Danse">
            <ns0:topConceptOf rdf:resource="http://scenepro.ca/taxonomies/Disciplines-asq#Scheme"/>
            <ns0:prefLabel xml:lang="fr">Danse</ns0:prefLabel>
            <ns0:inScheme rdf:resource="http://scenepro.ca/taxonomies/Disciplines-asq#Scheme"/>
            <ns0:definition xml:lang="fr">Un art du mouvement du corps, souvent en rythme avec la musique.</ns0:definition>
          </ns0:Concept>
        </ns0:broader>
        <ns0:prefLabel xml:lang="fr">Caribéenne et latino-américaine</ns0:prefLabel>
        <ns0:inScheme rdf:resource="http://scenepro.ca/taxonomies/Disciplines-asq#Scheme"/>
      </ns0:Concept>
    </ns0:broader>
    <ns0:prefLabel xml:lang="fr">Afro-caribéenne</ns0:prefLabel>
    <ns0:inScheme rdf:resource="http://scenepro.ca/taxonomies/Disciplines-asq#Scheme"/>
  </ns0:Concept>
  <ns0:Concept rdf:about="http://scenepro.ca/taxonomies/Disciplines-asq#Anticipation">
    <ns0:broader>
      <ns0:Concept rdf:about="http://scenepro.ca/taxonomies/Disciplines-asq#Theatre">
        <ns0:topConceptOf rdf:resource="http://scenepro.ca/taxonomies/Disciplines-asq#Scheme"/>
        <ns0:prefLabel xml:lang="fr">Théâtre</ns0:prefLabel>
        <ns0:inScheme rdf:resource="http://scenepro.ca/taxonomies/Disciplines-asq#Scheme"/>
        <ns0:definition xml:lang="fr">Un art de la représentation dramatique, souvent sur scène, impliquant des acteurs et un public.</ns0:definition>
      </ns0:Concept>
    </ns0:broader>
    <ns0:prefLabel xml:lang="fr">Anticipation</ns0:prefLabel>
    <ns0:inScheme rdf:resource="http://scenepro.ca/taxonomies/Disciplines-asq#Scheme"/>
  </ns0:Concept>
