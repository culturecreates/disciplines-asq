<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:ns0="http://www.w3.org/2004/02/skos/core#" xmlns:ns1="http://www.w3.org/2002/07/owl#" xmlns:ns2="http://purl.org/dc/terms/" xmlns:ns3="http://xmlns.com/foaf/0.1/" xmlns:ns4="http://purl.org/vocab/vann/" xmlns:ns5="http://www.w3.org/ns/prov#">
  <ns0:Concept rdf:about="http://scenepro.ca/taxonomies/Disciplines-asq#Absurde">
    <ns0:broader>
      <ns0:Concept rdf:about="http://scenepro.ca/taxonomies/Disciplines-asq#Humour">
        <ns0:topConceptOf rdf:resource="http://scenepro.ca/taxonomies/Disciplines-asq#Scheme"/>
        <ns0:prefLabel xml:lang="fr">Humour</ns0:prefLabel>
        <ns0:inScheme rdf:resource="http://scenepro.ca/taxonomies/Disciplines-asq#Scheme"/>
        <ns0:definition xml:lang="fr">Un art qui utilise le rire et la comédie pour divertir.</ns0:definition>
      </ns0:Concept>
    </ns0:broader>
    <ns0:prefLabel xml:lang="fr">Absurde</ns0:prefLabel>
    <ns0:inScheme rdf:resource="http://scenepro.ca/taxonomies/Disciplines-asq#Scheme"/>
  </ns0:Concept>
  <ns0:Concept rdf:about="http://scenepro.ca/taxonomies/Disciplines-asq#AcidJazz">
    <ns0:broader>
      <ns0:Concept rdf:about="http://scenepro.ca/taxonomies/Disciplines-asq#Jazz">
        <ns0:broader>
          <ns0:Concept rdf:about="http://scenepro.ca/taxonomies/Disciplines-asq#Musique">
            <ns0:topConceptOf rdf:resource="http://scenepro.ca/taxonomies/Disciplines-asq#Scheme"/>
            <ns0:prefLabel xml:lang="fr">Musique</ns0:prefLabel>
            <ns0:inScheme rdf:resource="http://scenepro.ca/taxonomies/Disciplines-asq#Scheme"/>
            <ns0:definition xml:lang="fr">Un art qui utilise le son et le rythme pour créer des compositions musicales.</ns0:definition>
          </ns0:Concept>
        </ns0:broader>
        <ns0:prefLabel xml:lang="fr">Jazz</ns0:prefLabel>
        <ns0:inScheme rdf:resource="http://scenepro.ca/taxonomies/Disciplines-asq#Scheme"/>
      </ns0:Concept>
    </ns0:broader>
    <ns0:prefLabel xml:lang="fr">Acid jazz</ns0:prefLabel>
    <ns0:inScheme rdf:resource="http://scenepro.ca/taxonomies/Disciplines-asq#Scheme"/>
  </ns0:Concept>
  <ns0:Concept rdf:about="http://scenepro.ca/taxonomies/Disciplines-asq#Acrobatie">
    <ns0:broader>
      <ns0:Concept rdf:about="http://scenepro.ca/taxonomies/Disciplines-asq#Cirque">
        <ns0:topConceptOf rdf:resource="http://scenepro.ca/taxonomies/Disciplines-asq#Scheme"/>
        <ns0:prefLabel xml:lang="fr">Cirque</ns0:prefLabel>
        <ns0:inScheme rdf:resource="http://scenepro.ca/taxonomies/Disciplines-asq#Scheme"/>
        <ns0:definition xml:lang="fr">Un spectacle qui combine des performances acrobatiques, de jonglerie, d'équilibre et d'autres arts du cirque.</ns0:definition>
      </ns0:Concept>
    </ns0:broader>
    <ns0:prefLabel xml:lang="fr">Acrobatie</ns0:prefLabel>
    <ns0:inScheme rdf:resource="http://scenepro.ca/taxonomies/Disciplines-asq#Scheme"/>
  </ns0:Concept>
